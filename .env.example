# Copia este archivo como .env (en la raiz del repo) antes de usar docker compose.
# .env esta en .gitignore: no lo subas al repositorio.

# Obligatoria. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0

# Opcionales: asistente de IA (sin ellas responde en modo automatico).
ASSISTANT_API_KEY=
ASSISTANT_MODEL=

# Nombre de las imagenes: <DOCKERHUB_USER>/pupigo-backend:<TAG>
DOCKERHUB_USER=pupigo
TAG=latest

# Puerto del host donde se publica la app (Nginx).
APP_PORT=80
