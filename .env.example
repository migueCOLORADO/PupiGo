# Archivo OPCIONAL. docker compose funciona sin .env: cada variable tiene valor por defecto.
# Copialo como .env (en la raiz del repo) solo si quieres personalizar algo.
# .env esta en .gitignore: no lo subas al repositorio.
#
# VITE_GOOGLE_MAPS_API_KEY es una Maps Demo Key compartida a proposito para pruebas locales.
# Tiene un tope diario de uso; si se agota, la app muestra el mapa SVG de respaldo.

# Llave del navegador para Google Maps JavaScript API (se inyecta en el build del frontend).
VITE_GOOGLE_MAPS_API_KEY=AIzaSyD1ODBWGU0Ys-zElpQpjSPa58U0mDWv1Hk

# Clave de los usuarios demo "conductor" y "estudiante" (seed_users al arrancar).
PUPIGO_DEMO_PASSWORD=PupiGo2026

# Puerto del host donde se publica la app (Nginx).
APP_PORT=80

# Etiqueta de las imagenes: <DOCKERHUB_USER>/pupigo-backend:<TAG>
TAG=v2

# 1 activa el modo depuracion de Django. Dejalo en 0 fuera de desarrollo.
DJANGO_DEBUG=0

# Clave secreta de Django. Si queda vacia, el backend genera una aleatoria en cada arranque.
# Llenala en produccion con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Llave del proveedor de IA para el asistente. Vacia = el asistente responde en modo automatico.
# Llenala solo si tienes una llave real.
ASSISTANT_API_KEY=

# Modelo de IA que usa el asistente. Vacio = modelo por defecto del backend.
# Llenalo solo si quieres otro modelo y definiste ASSISTANT_API_KEY.
ASSISTANT_MODEL=

# Usuario de Docker Hub para nombrar y publicar las imagenes. Vacio = "pupigo".
# Llenalo solo si vas a hacer push o pull de tus propias imagenes.
DOCKERHUB_USER=
