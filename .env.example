# Copia este archivo como .env (en la raiz del repo) antes de usar docker compose.
# .env esta en .gitignore: no lo subas al repositorio.

# Obligatoria. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0

# Opcionales: asistente de IA (sin ellas responde en modo automatico).
ASSISTANT_API_KEY=
ASSISTANT_MODEL=

# Nombre de las imagenes: <DOCKERHUB_USER>/pupigo-backend:<TAG>
DOCKERHUB_USER=pupigo
TAG=v2

# Puerto del host donde se publica la app (Nginx).
APP_PORT=80

# Clave de los usuarios demo "conductor" y "estudiante" (seed_users al arrancar).
# Si queda vacia, se genera una aleatoria y se imprime una sola vez en los logs del backend.
PUPIGO_DEMO_PASSWORD=

# Opcional: llave del navegador para Google Maps JavaScript API (se inyecta en el build del frontend).
# Restringela por dominio en Google Cloud. Vacia = mapa SVG de respaldo.
VITE_GOOGLE_MAPS_API_KEY=
